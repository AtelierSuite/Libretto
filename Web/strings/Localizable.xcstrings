    "Web.About.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A word processor that opens Word documents, Markdown, plain text and source code, and Pages documents, entirely on this device. Libretto works offline once it has loaded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word書類、Markdown、プレーンテキスト、ソースコード、Pages書類を開けるワープロです。すべてこのデバイス上で動作し、一度読み込めばオフラインでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word 문서, Markdown, 일반 텍스트, 소스 코드, Pages 문서를 여는 워드 프로세서입니다. 모든 작업이 이 기기에서 이루어지며, 한 번 불러오면 오프라인에서도 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可打开 Word 文稿、Markdown、纯文本、源代码和 Pages 文稿的文字处理应用。所有操作都在此设备上完成，载入一次后即可离线使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可打開 Word 文件、Markdown、純文字、原始碼和 Pages 文件的文書處理 App。所有操作都在此裝置上完成，載入一次後即可離線使用。"
          }
        }
      }
    },
