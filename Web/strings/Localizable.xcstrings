    "Mac.Notice.Converted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converted from a format Libretto can’t save in. Saving keeps it as a Word document."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Librettoで保存できないフォーマットから変換されました。保存するとWord書類になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libretto에서 저장할 수 없는 포맷에서 변환되었습니다. 저장하면 Word 문서로 보관됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已从 Libretto 无法存储的格式转换。存储后将保留为 Word 文稿。"
          }
        },
        "zh-Hant" : {
